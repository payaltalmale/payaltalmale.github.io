<style>
  :root{
    --bg: #0D1117;
    --panel: #121821;
    --panel-2: #161D28;
    --border: #232B38;
    --text: #E6EDF3;
    --muted: #7D8BA3;
    --muted-2: #4E5A70;
    --ok: #3FB950;
    --ok-dim: #1D3A24;
    --warn: #D4A72C;
    --warn-dim: #3A311A;
    --info: #58A6FF;
    --info-dim: #17263D;
    --fail: #F85149;
    --mono: 'JetBrains Mono', monospace;
    --sans: 'Inter', sans-serif;
  }

  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:var(--sans);
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  a{color:inherit;text-decoration:none;}

  ::selection{background:var(--info-dim); color:var(--info);}

  .wrap{max-width:980px;margin:0 auto;padding:0 28px;}

  /* background grid texture */
  body::before{
    content:"";
    position:fixed; inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 42px 42px;
    pointer-events:none;
    z-index:0;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 20%, transparent 75%);
  }

  /* ---------- NAV ---------- */
  header{
    position:sticky; top:0; z-index:50;
    background:rgba(13,17,23,0.85);
    backdrop-filter: blur(10px);
    border-bottom:1px solid var(--border);
  }
  nav.wrap{
    display:flex; align-items:center; justify-content:space-between;
    height:56px;
  }
  .brand{
    font-family:var(--mono); font-size:13px; font-weight:600;
    color:var(--text); display:flex; align-items:center; gap:8px;
  }
  .brand .cursor{
    display:inline-block; width:7px; height:14px; background:var(--ok);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink{50%{opacity:0;}}
  .navlinks{display:flex; gap:26px; font-family:var(--mono); font-size:12.5px; color:var(--muted);}
  .navlinks a:hover{color:var(--info);}
  @media (max-width:640px){ .navlinks{gap:14px; font-size:11px;} }

  /* ---------- HERO ---------- */
  .hero{
    position:relative; z-index:1;
    padding:76px 0 48px;
    border-bottom:1px solid var(--border);
  }
  .status-badge{
    display:inline-flex; align-items:center; gap:8px;
    font-family:var(--mono); font-size:11.5px; letter-spacing:.06em;
    color:var(--ok); background:var(--ok-dim);
    border:1px solid rgba(63,185,80,0.35);
    padding:5px 11px; border-radius:20px; margin-bottom:22px;
  }
  .status-badge .dot{width:6px;height:6px;border-radius:50%;background:var(--ok); box-shadow:0 0 8px var(--ok);}

  h1.name{
    font-family:var(--mono); font-weight:800;
    font-size:clamp(34px, 6vw, 58px);
    line-height:1.05; letter-spacing:-0.01em;
    color:var(--text);
  }
  .role-line{
    margin-top:14px; font-size:17px; color:var(--muted);
    max-width:640px;
  }
  .role-line b{color:var(--text); font-weight:600;}

  .metric-row{
    display:grid; grid-template-columns:repeat(4,1fr);
    gap:1px; margin-top:40px;
    background:var(--border);
    border:1px solid var(--border);
    border-radius:8px; overflow:hidden;
  }
  .metric{
    background:var(--panel); padding:16px 18px;
  }
  .metric .val{font-family:var(--mono); font-size:22px; font-weight:700; color:var(--text);}
  .metric .lbl{font-family:var(--mono); font-size:10.5px; color:var(--muted-2); text-transform:uppercase; letter-spacing:.07em; margin-top:4px;}
  @media (max-width:640px){ .metric-row{grid-template-columns:repeat(2,1fr);} }

  .contact-row{
    display:flex; flex-wrap:wrap; gap:10px; margin-top:26px;
  }
  .pill{
    font-family:var(--mono); font-size:12px; color:var(--muted);
    border:1px solid var(--border); padding:7px 13px; border-radius:6px;
    transition:.15s;
  }
  .pill:hover{border-color:var(--info); color:var(--info); background:var(--info-dim);}

  /* ---------- SECTION GENERAL ---------- */
  section{position:relative; z-index:1; padding:64px 0;}
  .eyebrow{
    font-family:var(--mono); font-size:12px; color:var(--muted-2);
    display:flex; align-items:center; gap:10px; margin-bottom:18px;
  }
  .eyebrow::before{content:"$"; color:var(--info);}
  .eyebrow .path{color:var(--info); }
  h2.section-title{
    font-family:var(--mono); font-size:26px; font-weight:700; margin-bottom:8px;
  }
  .section-sub{color:var(--muted); font-size:14.5px; margin-bottom:34px; max-width:600px;}

  /* summary panel */
  .panel{
    background:var(--panel); border:1px solid var(--border);
    border-radius:10px; padding:26px 28px;
  }
  .panel-head{
    display:flex; align-items:center; gap:8px; margin-bottom:16px;
    font-family:var(--mono); font-size:11px; color:var(--muted-2);
  }
  .traffic{display:flex; gap:6px;}
  .traffic span{width:9px;height:9px;border-radius:50%;}
  .traffic span:nth-child(1){background:#F85149;}
  .traffic span:nth-child(2){background:#D4A72C;}
  .traffic span:nth-child(3){background:#3FB950;}
  .summary-text{color:var(--text); font-size:15px; line-height:1.75;}
  .summary-text .kw{color:var(--info);}

  /* ---------- EXPERIENCE / JOB QUEUE ---------- */
  .job{
    border:1px solid var(--border); border-radius:10px;
    background:var(--panel); margin-bottom:16px; overflow:hidden;
  }
  .job-head{
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 22px; flex-wrap:wrap; gap:10px;
    border-bottom:1px solid var(--border);
    background:var(--panel-2);
  }
  .job-id{font-family:var(--mono); font-size:11.5px; color:var(--muted-2);}
  .job-title{font-weight:700; font-size:16px; margin-top:2px;}
  .job-state{
    font-family:var(--mono); font-size:10.5px; letter-spacing:.05em;
    padding:4px 10px; border-radius:20px;
    background:var(--ok-dim); color:var(--ok);
    border:1px solid rgba(63,185,80,0.35);
    white-space:nowrap; height:fit-content;
  }
  .job-body{padding:18px 22px 22px;}
  .job-body ul{list-style:none;}
  .job-body li{
    position:relative; padding-left:20px; margin-bottom:10px;
    font-size:14px; color:var(--muted);
  }
  .job-body li::before{
    content:"›"; position:absolute; left:0; color:var(--info); font-weight:700;
  }
  .job-body li b, .job-body li .hl{color:var(--text); font-weight:600;}
  .job-meta{
    display:flex; gap:18px; margin-top:14px; padding-top:14px;
    border-top:1px dashed var(--border);
    font-family:var(--mono); font-size:11px; color:var(--muted-2); flex-wrap:wrap;
  }

  /* org line */
  .org-line{
    display:flex; align-items:center; justify-content:space-between;
    margin-bottom:22px; flex-wrap:wrap; gap:8px;
  }
  .org-line .org{font-family:var(--mono); font-size:13px; color:var(--text);}
  .org-line .org span{color:var(--muted-2);}
  .org-line .dur{font-family:var(--mono); font-size:12px; color:var(--muted);}

  /* ---------- SKILLS ---------- */
  .skill-grid{
    display:grid; grid-template-columns:repeat(3,1fr); gap:14px;
  }
  @media (max-width:760px){ .skill-grid{grid-template-columns:1fr 1fr;} }
  @media (max-width:520px){ .skill-grid{grid-template-columns:1fr;} }
  .skill-mod{
    border:1px solid var(--border); border-radius:10px; padding:18px 18px 20px;
    background:var(--panel);
  }
  .skill-mod .mtitle{
    font-family:var(--mono); font-size:11px; color:var(--warn);
    letter-spacing:.06em; margin-bottom:12px; text-transform:uppercase;
  }
  .tag-list{display:flex; flex-wrap:wrap; gap:6px;}
  .tag{
    font-size:12px; font-family:var(--mono); color:var(--muted);
    background:var(--panel-2); border:1px solid var(--border);
    padding:4px 9px; border-radius:5px;
  }

  /* ---------- PROJECTS ---------- */
  .proj-grid{display:grid; grid-template-columns:1fr 1fr; gap:18px;}
  @media (max-width:760px){ .proj-grid{grid-template-columns:1fr;} }
  .proj-card{
    border:1px solid var(--border); border-radius:10px; background:var(--panel);
    padding:24px; display:flex; flex-direction:column;
    transition:.2s; position:relative; overflow:hidden;
  }
  .proj-card:hover{border-color:var(--info); transform:translateY(-2px);}
  .proj-top{display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:14px;}
  .proj-name{font-weight:700; font-size:17px;}
  .proj-link{font-family:var(--mono); font-size:11px; color:var(--info); white-space:nowrap;}
  .proj-desc{color:var(--muted); font-size:13.5px; line-height:1.7; flex:1;}
  .proj-desc .hl{color:var(--text);}
  .proj-stack{display:flex; flex-wrap:wrap; gap:6px; margin-top:16px;}

  /* ---------- EDUCATION ---------- */
  .edu-row{
    display:flex; justify-content:space-between; align-items:center;
    padding:18px 0; border-bottom:1px solid var(--border); flex-wrap:wrap; gap:6px;
  }
  .edu-row:last-child{border-bottom:none;}
  .edu-deg{font-weight:600; font-size:15px;}
  .edu-school{color:var(--muted); font-size:13px; margin-top:2px;}
  .edu-right{text-align:right; font-family:var(--mono); font-size:12px; color:var(--muted-2);}
  .edu-score{color:var(--ok); font-weight:600;}

  /* ---------- FOOTER ---------- */
  footer{
    border-top:1px solid var(--border); padding:46px 0 60px; position:relative; z-index:1;
  }
  .foot-inner{text-align:center;}
  .foot-title{font-family:var(--mono); font-size:22px; font-weight:700; margin-bottom:10px;}
  .foot-sub{color:var(--muted); font-size:14px; margin-bottom:28px;}
  .foot-links{display:flex; justify-content:center; gap:14px; flex-wrap:wrap;}
  .foot-btn{
    font-family:var(--mono); font-size:13px; padding:10px 18px; border-radius:7px;
    border:1px solid var(--border); background:transparent; color:var(--text);
    transition:.15s; cursor:pointer; line-height:1.2;
  }
  .foot-btn.primary{background:var(--info); color:#0D1117; border-color:var(--info); font-weight:600;}
  .foot-btn.primary:hover{opacity:.88;}
  .foot-btn:not(.primary):hover{border-color:var(--info); color:var(--info);}
  .foot-meta{
    margin-top:44px; text-align:center; font-family:var(--mono); font-size:11px; color:var(--muted-2);
  }

  @media (prefers-reduced-motion: reduce){
    *{animation:none !important; transition:none !important;}
  }
</style>
</head>
